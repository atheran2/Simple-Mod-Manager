<UserControl x:Class="VintageStoryModManager.Views.Controls.InstanceCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:VintageStoryModManager.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type={x:Type vm:InstanceCardViewModel}}"
             d:DesignHeight="220"
             d:DesignWidth="180"
             Width="180"
             Height="220">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Border Background="{DynamicResource Brush.Panel.Secondary.Background.Solid}"
            BorderBrush="{DynamicResource Brush.Panel.Primary.Border}"
            BorderThickness="1"
            CornerRadius="8"
            Cursor="Hand">

        <Grid>
            <Grid.RowDefinitions>
                <!-- Image/Icon area (clickable to launch) -->
                <RowDefinition Height="*" />
                <!-- Details area (clickable to edit) -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top Area: Instance Icon/Image - Click to Launch -->
            <Border Grid.Row="0"
                    x:Name="ImageArea"
                    Background="{DynamicResource Brush.Panel.Primary.Background.Solid}"
                    CornerRadius="8,8,0,0"
                    MouseLeftButtonDown="ImageArea_MouseLeftButtonDown"
                    Cursor="Hand">

                <Grid>
                    <!-- Custom icon image if available -->
                    <Image Source="{Binding IconImage}"
                           Stretch="UniformToFill"
                           Visibility="{Binding HasCustomIcon, Converter={StaticResource BoolToVis}}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />

                    <!-- Default icon: Large initial letter -->
                    <Border Background="{DynamicResource Brush.Accent.Primary}"
                            CornerRadius="8"
                            Width="80"
                            Height="80"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding HasCustomIcon, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasCustomIcon}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding NameInitial}"
                                   FontSize="42"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <!-- Play icon overlay on hover -->
                    <Border x:Name="PlayOverlay"
                            Background="#80000000"
                            CornerRadius="8,8,0,0"
                            Opacity="0">
                        <Path Data="M8,5.14V19.14L19,12.14L8,5.14Z"
                              Fill="White"
                              Width="48"
                              Height="48"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    </Border>
                </Grid>

                <Border.Triggers>
                    <EventTrigger RoutedEvent="MouseEnter">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="PlayOverlay"
                                                 Storyboard.TargetProperty="Opacity"
                                                 To="1"
                                                 Duration="0:0:0.15" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="MouseLeave">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="PlayOverlay"
                                                 Storyboard.TargetProperty="Opacity"
                                                 To="0"
                                                 Duration="0:0:0.15" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
            </Border>

            <!-- Bottom Area: Instance Details - Click to Edit -->
            <Border Grid.Row="1"
                    x:Name="DetailsArea"
                    Background="{DynamicResource Brush.Panel.Secondary.Background.Solid}"
                    CornerRadius="0,0,8,8"
                    Padding="10,8,10,10"
                    MouseLeftButtonDown="DetailsArea_MouseLeftButtonDown"
                    Cursor="Hand">

                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Brush.Panel.Primary.Background.Solid}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel>
                    <!-- Instance Name -->
                    <TextBlock Text="{Binding Name}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Text.Primary}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Name}" />

                    <!-- Stats Row 1: Playtime | Version -->
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <!-- Playtime -->
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22C6.47,22 2,17.5 2,12A10,10 0 0,1 12,2M12.5,7V12.25L17,14.92L16.25,16.15L11,13V7H12.5Z"
                                  Fill="{DynamicResource Brush.Text.Subtle}"
                                  Width="12"
                                  Height="12"
                                  Stretch="Uniform"
                                  Margin="0,0,4,0" />
                            <TextBlock Text="{Binding PlaytimeDisplay}"
                                       FontSize="11"
                                       Foreground="{DynamicResource Brush.Text.Subtle}" />
                        </StackPanel>

                        <TextBlock Text=" | "
                                   FontSize="11"
                                   Foreground="{DynamicResource Brush.Text.Subtle}" />

                        <!-- Game Version -->
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M21,16.5C21,16.88 20.79,17.21 20.47,17.38L12.57,21.82C12.41,21.94 12.21,22 12,22C11.79,22 11.59,21.94 11.43,21.82L3.53,17.38C3.21,17.21 3,16.88 3,16.5V7.5C3,7.12 3.21,6.79 3.53,6.62L11.43,2.18C11.59,2.06 11.79,2 12,2C12.21,2 12.41,2.06 12.57,2.18L20.47,6.62C20.79,6.79 21,7.12 21,7.5V16.5Z"
                                  Fill="{DynamicResource Brush.Text.Subtle}"
                                  Width="12"
                                  Height="12"
                                  Stretch="Uniform"
                                  Margin="0,0,4,0" />
                            <TextBlock Text="{Binding GameVersion}"
                                       FontSize="11"
                                       Foreground="{DynamicResource Brush.Text.Subtle}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Stats Row 2: Mod Count -->
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <Path Data="M20,6H12L10,4H4A2,2 0 0,0 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8A2,2 0 0,0 20,6Z"
                              Fill="{DynamicResource Brush.Text.Subtle}"
                              Width="12"
                              Height="12"
                              Stretch="Uniform"
                              Margin="0,0,4,0" />
                        <TextBlock Text="{Binding ModCountDisplay}"
                                   FontSize="11"
                                   Foreground="{DynamicResource Brush.Text.Subtle}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
