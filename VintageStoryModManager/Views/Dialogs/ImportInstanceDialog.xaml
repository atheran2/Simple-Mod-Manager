<Window x:Class="VintageStoryModManager.Views.Dialogs.ImportInstanceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import Instance"
        Width="600"
        Height="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        WindowStyle="SingleBorderWindow"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Window.Shell.Background.Solid}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <Grid Margin="20"
          Background="{DynamicResource Brush.Panel.Primary.Background.Solid}"
          TextElement.Foreground="{DynamicResource Brush.Text.Primary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Instance Name -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Instance Name:"
                       Margin="0,0,0,6" />
            <TextBox x:Name="InstanceNameTextBox"
                     Background="{DynamicResource Brush.Dialog.TextBox.Background}"
                     BorderBrush="{DynamicResource Brush.Dialog.TextBox.Border}"
                     SelectionBrush="{DynamicResource Brush.Dialog.TextBox.SelectionBackground}"
                     SelectionTextBrush="{DynamicResource Brush.Dialog.TextBox.SelectionForeground}"
                     CaretBrush="{DynamicResource Brush.Dialog.TextBox.Caret}" />
        </StackPanel>

        <!-- Source Info -->
        <Border Grid.Row="1"
                BorderThickness="1"
                BorderBrush="{DynamicResource Brush.Panel.Secondary.Background.Solid}"
                Background="{DynamicResource Brush.Panel.Secondary.Background.Solid}"
                Padding="12"
                Margin="0,0,0,16">
            <StackPanel>
                <TextBlock x:Name="SourceInfoText"
                           Opacity="0.8" />
                <TextBlock x:Name="VsVersionText"
                           Margin="0,4,0,0"
                           Opacity="0.7" />
                <TextBlock x:Name="DescriptionText"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />
            </StackPanel>
        </Border>

        <!-- Mods Header -->
        <TextBlock Grid.Row="2"
                   Margin="0,0,0,6">
            <Run x:Name="ModsHeaderRun" Text="Mods (0)" />
        </TextBlock>

        <!-- Mods List -->
        <Border Grid.Row="3"
                BorderThickness="1"
                BorderBrush="{DynamicResource Brush.Panel.Secondary.Background.Solid}"
                Background="{DynamicResource Brush.Panel.Secondary.Background.Solid}"
                Padding="4">
            <ListView x:Name="ModsListView"
                      Background="Transparent"
                      BorderThickness="0">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Status" Width="60">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StatusIcon}"
                                               FontFamily="Segoe UI Symbol"
                                               FontSize="14"
                                               HorizontalAlignment="Center" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Mod" Width="250">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Version" Width="80">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Version}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Note" Width="150">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding UnavailableReason}"
                                               Foreground="{DynamicResource Brush.Text.Warning}"
                                               TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <!-- Categories & Configs Info -->
        <StackPanel Grid.Row="4" Margin="0,8,0,0">
            <TextBlock x:Name="CategoriesInfoText" Opacity="0.7" />
            <TextBlock x:Name="ConfigsInfoText" Opacity="0.7" />
        </StackPanel>

        <!-- Warnings -->
        <Border Grid.Row="5"
                x:Name="WarningsPanel"
                BorderThickness="1"
                BorderBrush="{DynamicResource Brush.Warning.Border}"
                Background="{DynamicResource Brush.Warning.Background}"
                Padding="12"
                Margin="0,12,0,0"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="Warnings:"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Warning.Foreground}"
                           Margin="0,0,0,4" />
                <TextBlock x:Name="WarningsText"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource Brush.Warning.Foreground}" />
            </StackPanel>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button x:Name="ImportButton"
                    Content="Import"
                    MinWidth="88"
                    Margin="0,0,12,0"
                    Click="ImportButton_OnClick" />
            <Button Content="Cancel"
                    MinWidth="88"
                    IsCancel="True" />
        </StackPanel>

        <!-- Loading Overlay -->
        <Border x:Name="LoadingOverlay"
                Grid.Row="0"
                Grid.RowSpan="7"
                Background="#80000000"
                Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock x:Name="LoadingText"
                           Text="Loading..."
                           FontSize="16"
                           Foreground="White"
                           HorizontalAlignment="Center" />
                <ProgressBar x:Name="ImportProgressBar"
                             Width="300"
                             Height="20"
                             Margin="0,12,0,0"
                             Minimum="0"
                             Maximum="100" />
                <TextBlock x:Name="ImportProgressText"
                           Text=""
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
