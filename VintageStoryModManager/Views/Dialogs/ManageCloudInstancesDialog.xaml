<Window x:Class="VintageStoryModManager.Views.Dialogs.ManageCloudInstancesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage My Cloud Instances"
        SizeToContent="WidthAndHeight"
        MinWidth="580"
        MinHeight="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanMinimize"
        WindowStyle="SingleBorderWindow"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Window.Shell.Background.Solid}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Window.Resources>
    <Grid Margin="20"
          Background="{DynamicResource Brush.Panel.Primary.Background.Solid}"
          TextElement.Foreground="{DynamicResource Brush.Text.Primary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Select one of your uploaded instances to view details, toggle visibility, or delete it."
                   Grid.Row="0"
                   Margin="0,0,0,12"
                   TextWrapping="Wrap"
                   FontSize="14" />

        <Border Grid.Row="1"
                Width="520"
                Background="Transparent"
                BorderBrush="{DynamicResource Brush.SunkenSurface.Bevel.Light}"
                BorderThickness="0,0,1,1"
                SnapsToDevicePixels="True">
            <Border Background="Transparent"
                    BorderBrush="{DynamicResource Brush.SunkenSurface.Bevel.Dark}"
                    BorderThickness="1,1,0,0"
                    SnapsToDevicePixels="True">
                <ListView x:Name="InstancesListView"
                          MinHeight="180"
                          HorizontalAlignment="Stretch"
                          SelectionMode="Single"
                          SelectionChanged="InstancesListView_OnSelectionChanged"
                          Background="{DynamicResource Brush.Panel.Secondary.Background.Solid}"
                          BorderThickness="0"
                          Foreground="{DynamicResource Brush.Text.Primary}">
                    <ListView.Resources>
                        <Style TargetType="GridViewColumnHeader">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                            <Setter Property="Background"
                                    Value="{DynamicResource Brush.Button.Primary.Background.Normal}" />
                            <Setter Property="BorderBrush"
                                    Value="{DynamicResource Brush.Panel.Secondary.Background.Solid}" />
                        </Style>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                            <Setter Property="Background"
                                    Value="{DynamicResource Brush.Panel.Secondary.Background.Solid}" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="Padding" Value="8,4" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border x:Name="ContainerBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                SnapsToDevicePixels="True">
                                            <ContentPresenter
                                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background"
                                            Value="{DynamicResource Brush.Button.Primary.Background.Hover}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Selection.Background}" />
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource Brush.Text.SelectionForeground}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.Resources>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Slot" DisplayMemberBinding="{Binding SlotLabel}" Width="70" />
                            <GridViewColumn Header="Name" DisplayMemberBinding="{Binding EffectiveName}" Width="200" />
                            <GridViewColumn Header="VS Version" DisplayMemberBinding="{Binding TargetVsVersion}" Width="80" />
                            <GridViewColumn Header="Mods" DisplayMemberBinding="{Binding ModsSummary}" Width="80" />
                            <GridViewColumn Header="Visibility" DisplayMemberBinding="{Binding VisibilityDisplay}" Width="70" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>
        </Border>

        <!-- Selected instance details -->
        <Border Grid.Row="2"
                Margin="0,12,0,0"
                Padding="10"
                Background="{DynamicResource Brush.Panel.Secondary.Background.Solid}"
                CornerRadius="4"
                Visibility="{Binding HasSelection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
                <TextBlock x:Name="SelectedInstanceNameText"
                           FontWeight="Bold"
                           FontSize="14"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="SelectedInstanceDescriptionText"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap"
                           MaxHeight="60"
                           TextTrimming="CharacterEllipsis"
                           Opacity="0.8" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button x:Name="ToggleVisibilityButton"
                    Content="Toggle Visibility"
                    MinWidth="110"
                    Margin="0,0,12,0"
                    Click="ToggleVisibilityButton_OnClick"
                    ToolTip="Switch between Public and Unlisted" />
            <Button x:Name="DeleteButton"
                    Content="Delete"
                    MinWidth="88"
                    Margin="0,0,12,0"
                    Background="{DynamicResource Brush.Status.Error}"
                    Foreground="{DynamicResource Brush.Text.Primary}"
                    Click="DeleteButton_OnClick" />
            <Button Content="Close"
                    MinWidth="88"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
