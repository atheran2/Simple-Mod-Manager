<Window x:Class="VintageStoryModManager.Views.Dialogs.ModDescriptionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mod Description"
        Width="800"
        Height="600"
        MinWidth="500"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Window.Shell.Background.Solid}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock x:Name="ModNameText"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Text.Primary}"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="ModAuthorText"
                       FontSize="14"
                       Foreground="{DynamicResource Brush.Text.Subtle}"
                       Margin="0,4,0,0" />
        </StackPanel>

        <!-- Loading indicator -->
        <StackPanel x:Name="LoadingPanel"
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
            <TextBlock FontSize="14"
                       Foreground="{DynamicResource Brush.Text.Subtle}"
                       Text="Loading description..." />
        </StackPanel>

        <!-- Description content using WebBrowser for HTML -->
        <Border Grid.Row="1"
                Background="{DynamicResource Brush.Panel.Secondary.Background.Solid}"
                CornerRadius="8"
                Padding="4">
            <WebBrowser x:Name="DescriptionBrowser"
                        Navigating="DescriptionBrowser_Navigating" />
        </Border>

        <!-- Footer -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button x:Name="ViewOnWebsiteButton"
                    Content="View on Website"
                    Padding="16,8"
                    Margin="0,0,12,0"
                    Click="ViewOnWebsite_Click"
                    Style="{StaticResource IMM.ButtonBaseStyle}" />
            <Button Content="Close"
                    Padding="16,8"
                    IsCancel="True"
                    Style="{StaticResource IMM.ButtonBaseStyle}" />
        </StackPanel>
    </Grid>
</Window>
