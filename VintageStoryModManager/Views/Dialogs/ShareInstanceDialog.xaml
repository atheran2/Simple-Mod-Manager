<Window x:Class="VintageStoryModManager.Views.Dialogs.ShareInstanceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Share Instance"
        SizeToContent="WidthAndHeight"
        MinWidth="500"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Window.Shell.Background.Solid}">
    <Grid Margin="20"
          Background="{DynamicResource Brush.Panel.Primary.Background.Solid}"
          TextElement.Foreground="{DynamicResource Brush.Text.Primary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Instance Info -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock x:Name="InstanceNameText"
                       FontSize="16"
                       FontWeight="SemiBold" />
            <TextBlock x:Name="ModCountText"
                       Opacity="0.7"
                       Margin="0,4,0,0" />
            <TextBlock x:Name="VsVersionText"
                       Opacity="0.7" />
        </StackPanel>

        <!-- Description -->
        <TextBlock Grid.Row="1"
                   Text="Description (shown to others when browsing):"
                   Margin="0,0,0,6" />
        <TextBox x:Name="DescriptionTextBox"
                 Grid.Row="2"
                 Height="80"
                 Margin="0,0,0,16"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 Background="{DynamicResource Brush.Dialog.TextBox.Background}"
                 BorderBrush="{DynamicResource Brush.Dialog.TextBox.Border}"
                 SelectionBrush="{DynamicResource Brush.Dialog.TextBox.SelectionBackground}"
                 SelectionTextBrush="{DynamicResource Brush.Dialog.TextBox.SelectionForeground}"
                 CaretBrush="{DynamicResource Brush.Dialog.TextBox.Caret}" />

        <!-- Include Options -->
        <Border Grid.Row="3"
                BorderThickness="1"
                BorderBrush="{DynamicResource Brush.Panel.Secondary.Background.Solid}"
                Background="{DynamicResource Brush.Panel.Secondary.Background.Solid}"
                Padding="12"
                Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Include Options"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8" />
                <CheckBox x:Name="IncludeConfigsCheckBox"
                          Content="Include mod configurations"
                          IsChecked="True"
                          Margin="0,0,0,6">
                    <CheckBox.LayoutTransform>
                        <ScaleTransform ScaleX="1.1" ScaleY="1.1" />
                    </CheckBox.LayoutTransform>
                </CheckBox>
                <CheckBox x:Name="IncludeCategoriesCheckBox"
                          Content="Include categories"
                          IsChecked="True">
                    <CheckBox.LayoutTransform>
                        <ScaleTransform ScaleX="1.1" ScaleY="1.1" />
                    </CheckBox.LayoutTransform>
                </CheckBox>
            </StackPanel>
        </Border>

        <!-- Share Method -->
        <Border Grid.Row="4"
                BorderThickness="1"
                BorderBrush="{DynamicResource Brush.Panel.Secondary.Background.Solid}"
                Background="{DynamicResource Brush.Panel.Secondary.Background.Solid}"
                Padding="12"
                Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Share Method"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8" />
                <RadioButton x:Name="SaveToFileRadio"
                             Content="Save to file (.vsinstance)"
                             IsChecked="True"
                             GroupName="ShareMethod"
                             Margin="0,0,0,6">
                    <RadioButton.LayoutTransform>
                        <ScaleTransform ScaleX="1.1" ScaleY="1.1" />
                    </RadioButton.LayoutTransform>
                </RadioButton>
                <RadioButton x:Name="UploadToCloudRadio"
                             Content="Upload to cloud"
                             GroupName="ShareMethod"
                             Margin="0,0,0,6"
                             IsEnabled="False"
                             ToolTip="Cloud sharing coming soon">
                    <RadioButton.LayoutTransform>
                        <ScaleTransform ScaleX="1.1" ScaleY="1.1" />
                    </RadioButton.LayoutTransform>
                </RadioButton>
                <StackPanel Margin="20,0,0,0"
                            IsEnabled="{Binding IsChecked, ElementName=UploadToCloudRadio}">
                    <RadioButton x:Name="PublicVisibilityRadio"
                                 Content="Public (visible in browse list)"
                                 GroupName="Visibility"
                                 Margin="0,0,0,4">
                        <RadioButton.LayoutTransform>
                            <ScaleTransform ScaleX="1.0" ScaleY="1.0" />
                        </RadioButton.LayoutTransform>
                    </RadioButton>
                    <RadioButton x:Name="UnlistedVisibilityRadio"
                                 Content="Unlisted (link sharing only)"
                                 IsChecked="True"
                                 GroupName="Visibility">
                        <RadioButton.LayoutTransform>
                            <ScaleTransform ScaleX="1.0" ScaleY="1.0" />
                        </RadioButton.LayoutTransform>
                    </RadioButton>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="8"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button x:Name="ShareButton"
                    Content="Share"
                    MinWidth="88"
                    Margin="0,0,12,0"
                    Click="ShareButton_OnClick" />
            <Button Content="Cancel"
                    MinWidth="88"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
